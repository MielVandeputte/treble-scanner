{
  "name": "treble-scanner",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc && vite build",
    "start": "vite preview",
    "check:format": "prettier --check \"**/*.{js,tsx,ts,css,jsx,json}\"",
    "check:lint": "eslint",
    "check": "npm run check:format && npm run check:lint",
    "fix:format": "prettier --write \"**/*.{js,tsx,ts,css,jsx,json}\"",
    "fix:lint": "eslint --fix",
    "fix": "npm run fix:format && npm run fix:lint",
    "test:vitest": "vitest run",
    "test:playwright": "npx playwright test",
    "test": "npm run test:vitest && npm run test:playwright",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@fontsource/proza-libre": "5.3.0",
    "clsx": "2.1.1",
    "motion": "14.1.0",
    "qr-scanner": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "store2": "2.14.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "77.0.0",
    "@faker-js/faker": "10.6.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
